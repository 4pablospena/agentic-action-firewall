{
  "name": "@agent-firewall/core",
  "version": "0.0.0",
  "description": "Core firewall engine for Agent Action Firewall",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run test/smoke.test.ts test/policy-loader.test.ts test/callbacks.test.ts test/wrap-context.test.ts test/wrap-r2-cancel.test.ts",
    "test:behavioral": "vitest run test/behavioral",
    "typecheck": "tsc --noEmit",
    "generate:types": "node scripts/generate-types.mjs"
  },
  "dependencies": {
    "@agent-firewall/schemas": "workspace:*",
    "@noble/ed25519": "^2.2.3",
    "@noble/hashes": "^1.8.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.21",
    "json-schema-to-typescript": "^15.0.4",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
