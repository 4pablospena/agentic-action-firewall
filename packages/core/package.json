{
  "name": "@agent-firewall/core",
  "version": "0.0.0",
  "description": "Core firewall engine for Agent Action Firewall",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "generate:types": "node scripts/generate-types.mjs"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^15.0.4",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
