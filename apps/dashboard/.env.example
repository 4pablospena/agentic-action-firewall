# Copy to apps/dashboard/.env before `pnpm dev`

DATABASE_URL=postgresql://aaf:aaf@localhost:5432/aaf_dashboard
NUXT_SESSION_PASSWORD=local-dev-session-password-min-32-chars

# GitHub OAuth (https://github.com/settings/developers — callback: http://localhost:3000/auth/github)
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=

# Local dev without GitHub OAuth (dev server only; ignored in production builds)
NUXT_DEV_AUTH_BYPASS=true

# Auto-seed demo audit data on `pnpm dev` when bypass is enabled (set false to disable)
NUXT_AUTO_SEED=true

# Optional: distributed kill switch (docker compose up redis control-plane)
NUXT_CONTROL_PLANE_URL=
NUXT_CONTROL_PLANE_TOKEN=

# Optional: Slack bot for rich approval blocks (falls back to incoming webhook URL)
NUXT_SLACK_BOT_TOKEN=
NUXT_SLACK_APPROVAL_CHANNEL=

# Optional: approval notifications (Slice 7)
NUXT_APPROVAL_WEBHOOK_URL=
NUXT_SLACK_WEBHOOK_URL=
NUXT_RESEND_API_KEY=
NUXT_TWILIO_ACCOUNT_SID=
NUXT_TWILIO_AUTH_TOKEN=
NUXT_NOTIFICATION_EMAIL=
NUXT_NOTIFICATION_PHONE=
