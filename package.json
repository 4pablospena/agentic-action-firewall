{
  "name": "agent-action-firewall",
  "private": true,
  "description": "Runtime protection layer for AI agent actions",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate:schemas": "pnpm --filter @agent-firewall/schemas validate",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:behavioral": "pnpm --filter @agent-firewall/core test:behavioral",
    "test:integration": "pnpm --filter @agent-firewall/control-plane test:integration",
    "typecheck": "pnpm build && pnpm -r typecheck",
    "generate:types": "pnpm --filter @agent-firewall/core generate:types",
    "dev:dashboard": "pnpm --filter @agent-firewall/dashboard dev",
    "changeset": "changeset",
    "aaf": "aaf"
  },
  "devDependencies": {
    "@agent-firewall/cli": "workspace:*",
    "@changesets/cli": "^2.29.2"
  }
}
